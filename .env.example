# Copy to .env and change the values. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database (postgres or sqlite; sqlite is only for quick local tests)
DB_ENGINE=postgres
POSTGRES_DB=hrms
POSTGRES_USER=hrms
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Where uploaded documents (term letters) are stored. Private: never served directly.
PRIVATE_MEDIA_ROOT=/data/private_media

# JWT lifetimes (minutes / days)
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Leave: month the leave year starts (1 = January) and the full-year default allowance in days
LEAVE_YEAR_START_MONTH=1
DEFAULT_ANNUAL_LEAVE_DAYS=28

# Email alerts (queued in the database, sent through Kafka)
NOTIFICATIONS_BUS=kafka
SITE_URL=http://localhost:3000
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For real email use django.core.mail.backends.smtp.EmailBackend and fill these in (never commit real values):
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=HRMS <no-reply@example.com>

# Kafka topic and consumer group for the notifications worker (defaults shown)
NOTIFICATION_TOPIC=hrms.notifications
NOTIFICATION_CONSUMER_GROUP=hrms-notifications

# Payroll: key that encrypts employees' bank details (Fernet key; generate and keep safe, see settings.py)
PAYROLL_ENCRYPTION_KEY=
PAYROLL_EXTRA_HOURS_TOLERANCE_MINUTES=15
PAYROLL_PENSION_TAX_METHOD=net_pay
PAYROLL_BANK_HOLIDAY_MULTIPLIER=1

# Virus scanning of uploads (ClamAV). 'off' is only allowed to be the default while DJANGO_DEBUG=true.
UPLOAD_SCANNING=clamd
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=15

# Website dev server only (frontend/vite.config.js): where the dev proxy sends /api and /api/clock
# HRMS_DJANGO=http://127.0.0.1:8000
# HRMS_CLOCK=http://127.0.0.1:8001

# Tests only: set to 1 to run the tests that need a real Kafka or ClamAV
# HRMS_TEST_KAFKA=
# HRMS_TEST_CLAMAV=
